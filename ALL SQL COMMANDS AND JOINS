-----------------------------SQL JOINS-----------------------------------------------------
----->1.INNER JOIN
SELECT
   E.EMPNO,E.ENAME,E.JOB,E.SAL,D.DEPTNO,D.DNAME
FROM 
   EMP E INNER JOIN DEPT D
ON
   E.DEPTNO=D.DEPTNO
ORDER BY DEPTNO

------>2.SELF JOIN
SELECT
    E.EMPNO,E.ENAME,E.JOB,M.EMPNO AS MGR_N0,M.ENAME AS MGR_NAME
FROM
   EMP E,EMP M
WHERE
   E.MGR=M.EMPNO
ORDER BY M.EMPNO

---->3.CROSS JOIN
SELECT
   E.EMPNO,E.ENAME,E.JOB,E.SAL,D.DEPTNO,D.DNAME
FROM
   EMP E CROSS JOIN DEPT D
ORDER BY DEPTNO

----->4.OUTER JOIN
----->DIVIDED INTO 3 TYPES
--->1.LEFT OUTER JOIN
SELECT
   E.EMPNO,E.ENAME,E.JOB,E.SAL,D.DEPTNO,D.DNAME
FROM
   EMP E LEFT OUTER JOIN DEPT D
ON
   E.DEPTNO=D.DEPTNO
ORDER BY D.DEPTNO

---->2.RIGHT OUTER JOIN
SELECT
   E.EMPNO,E.ENAME,E.JOB,E.SAL,D.DEPTNO,D.DNAME
FROM
   EMP E RIGHT OUTER JOIN DEPT D
ON
   E.DEPTNO=D.DEPTNO
ORDER BY D.DEPTNO

------>3.FULL OUTER JOIN
SELECT
    E.EMPNO,E.ENAME,E.JOB,E.SAL,D.DEPTNO,D.DNAME
FROM
    EMP E FULL OUTER JOIN DEPT D
ON
    E.DEPTNO=D.DEPTNO
ORDER BY D.DEPTNO

