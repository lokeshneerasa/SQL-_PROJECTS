------------------------------HAVING CLAUSE--------------------------------------------
-----GROUP BY AND HAVING CLAUSE
--->TO COUNT NO.OF EMPS
SELECT COUNT(*) AS NO_OF_EMPS FROM EMP

---->TO COUNT NO.OF EMPS IN DEPT WISE
SELECT DEPTNO,COUNT(*) AS NO_OF_EMPS FROM EMP
GROUP BY DEPTNO ORDER BY DEPTNO

---->FIND HIGHEST SALARIES IN EACH DEPT
SELECT DEPTNO,MAX(SAL) AS HIGH_SAL FROM EMP
GROUP BY DEPTNO ORDER BY DEPTNO

---->TO LIST DEPTS WHICH CONTAIN ATLEAST 5 EMPS
SELECT DEPTNO,COUNT(*) AS NO_OF_EMPS FROM EMP
GROUP BY DEPTNO
HAVING COUNT(*)>=5

---->TO FIND JUNIOR MOST AND SENIOR MOST JOINING DATE
SELECT MAX(HIREDATE),MIN(HIREDATE) FROM EMP

---->TO FIND SENIOR MOST EMPLOYEE
SELECT EMPNO,ENAME,HIREDATE FROM EMP
WHERE HIREDATE=(SELECT MIN(HIREDATE) FROM EMP)

---->TO FIND SENIOR MOST EMP IN EACH DEPTNO
SELECT EMPNO,ENAME,HIREDATE,DEPTNO FROM EMP
WHERE HIREDATE IN(SELECT MIN(HIREDATE) FROM EMP GROUP BY DEPTNO)
ORDER BY DEPTNO

