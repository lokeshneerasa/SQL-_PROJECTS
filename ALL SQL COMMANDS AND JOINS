---------------------ARITHMETIC OPERATORS(+-*%)-------------------------------------------
SELECT ENAME,EMPNO,SAL,SAL+5000 AS BONUS FROM EMP -----USING(+)OPERATOR
SELECT ENAME,EMPNO,SAL,SAL-500 AS BONUS FROM EMP -----USING(-)OPERATOR
SELECT ENAME,EMPNO,SAL,SAL*2 AS BONUS FROM EMP -------USING(*)OPERATOR
SELECT ENAME,EMPNO,SAL,(SAL*50)/100 AS BONUS FROM EMP ---USING(%)OPERATOR

---------------------COMPARSION OPERATORS(=,!=,<,<=,>,>=)-----------------------------
SELECT*FROM EMP WHERE JOB='MANAGER'-----USING(=)OPERATOR
SELECT*FROM EMP WHERE JOB!='MANAGER'----USING(!=)OPERATOR
SELECT*FROM EMP WHERE SAL<3000----------USING(<(LESSTHAN))
SELECT*FROM EMP WHERE SAL<=1500---------USING(<=(LESSTHAN OR EQUALTO))
SELECT*FROM EMP WHERE SAL>2000----------USING(>(GREATER THAN))
SELECT*FROM EMP WHERE DEPTNO>=20--------USING(>=(GREATER THAN OR EQUALTO))
SELECT*FROM EMP WHERE DEPTNO>=20 ORDER BY DEPTNO
SELECT*FROM EMP WHERE DEPTNO>=20 ORDER BY SAL

----------------------LOGICAL OPERATORS(AND,OR,BETWEEN,NOT,LIKE,IN,ANY,ALL)-------------------------
SELECT*FROM EMP WHERE SAL>2000 AND SAL<3000
SELECT*FROM EMP WHERE JOB='CLERK' OR JOB='ANALYST'
SELECT*FROM EMP WHERE SAL BETWEEN 1500 AND 2500
SELECT*FROM EMP WHERE NOT SAL=1300 ORDER BY DEPTNO
SELECT*FROM EMP WHERE ENAME LIKE 'S%'----------(START WITH LETTER S)
SELECT*FROM EMP WHERE ENAME LIKE '%S'----------(END  WITH  LETTER S)
SELECT*FROM EMP WHERE ENAME NOT LIKE 'S%'
SELECT*FROM EMP WHERE ENAME NOT LIKE '%S'
SELECT*FROM EMP WHERE JOB IN('CLERK','MANAGER')
SELECT*FROM EMP WHERE JOB NOT IN('CLERK','MANAGER')
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP------------------>ANY
WHERE SAL>ANY(SELECT SAL FROM EMP WHERE DEPTNO=20)---------->OPERATOR
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP-------------->ALL
WHERE SAL>ALL(SELECT SAL FROM EMP WHERE DEPTNO=20)------->OPERATOR

---------------------SET OPERATORS(UNION,UNIONALL,INTERSECT,MINUS)
----->SQL UNION(WITHOUT DUPLICATE VALUES)
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP WHERE DEPTNO IN(10,20)
UNION
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP WHERE DEPTNO IN(10,30)
ORDER BY DEPTNO
----->SQL UNION ALL(WITH DUPLICATE VALUES)
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP WHERE DEPTNO IN(10,20)
UNION ALL
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP WHERE DEPTNO IN(10,30)
ORDER BY DEPTNO
----->SQL INTERSECT(COMMON VALUES)
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP WHERE DEPTNO IN(10,20)
INTERSECT
SELECT EMPNO,ENAME,JOB,SAL,DEPTNO FROM EMP WHERE DEPTNO IN(10,30)
ORDER BY DEPTNO

