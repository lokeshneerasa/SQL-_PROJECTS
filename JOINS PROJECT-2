---Join Questions
---?? Basic
--1.List all customers with their orders
select c.customer_id,c.name,o.order_id,o.order_date
from customer c
join orders o
on c.customer_id=o.customer_id

--2.Show customer name and order amount
select c.name,o.amount
from customer c
join orders o
on c.customer_id=o.customer_id

--3.Display all orders with customer city
select c.city,o.order_id,o.order_date
from customer c
inner join orders o
on c.customer_id=o.customer_id

--4.Show all products in each order
select p.product_id,p.product_name,i.order_id
from products p
join order_items i
on p.product_id=i.product_id

--?? Intermediate
--Show customer name, product name, and quantity
select c.name,p.product_name,i.quantity
from customer c
inner join orders o on c.customer_id=o.customer_id
inner join order_items i on o.order_id=i.order_id
inner join products p on i.product_id=p.product_id

--List all orders with total items purchased
select o.order_id,sum(i.quantity) as total_items
from orders o  
join order_items i
on o.order_id = i.order_id
group by o.order_id

--Show all customers who placed orders (INNER JOIN)
select c.customer_id,c.name,o.order_id
from customer c
inner join orders o
on c.customer_id = o.customer_id

--Show all customers including those without orders (LEFT JOIN)
select c.customer_id,c.name,o.order_id
from customer c
left join orders o
on c.customer_id = o.customer_id

--Display products that were never ordered
select p.product_id,p.product_name,i.order_id
from products p
left join order_items i
on p.product_id = i.product_id

--?? Advanced
--Show customer name and total amount spent
select c.name,sum(o.amount) as total_amount
from customer c
inner join orders o
on c.customer_id = o.customer_id
group by c.name

--Find top-selling product (using JOIN + GROUP BY)
select top 1
p.product_id,p.product_name,sum(i.quantity) as total_sold
from products p
inner join order_items i
on p.product_id = i.product_id
group by p.product_id,p.product_name
order by total_sold desc

--List customers who bought more than 2 different products
select c.name,c.customer_id
from customer c
join orders o on c.customer_id=o.customer_id
join order_items i on o.order_id=i.order_id
group by c.customer_id,c.name
having count(distinct i.product_id)>2

--Show orders with more than 2 items
select o.order_id,sum(i.quantity) as total_items
from orders o
join order_items i
on o.order_id=i.order_id
group by o.order_id
having sum(i.quantity)>2

--Display customer who spent the highest amount
select top 1 c.customer_id,c.name,max(o.amount) as highest_amount
from customer c
join orders o
on c.customer_id=o.customer_id
group by c.customer_id,c.name
order by highest_amount desc
