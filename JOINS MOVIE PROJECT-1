------Queries----
---1.view all movies with avg rating
select m.movie_id,m.title,avg(r.rating) as avgrating
from movies m
inner join rating r 
on m.movie_id = r.movie_id
group by m.movie_id, m.title

---2.find highest rated movie in each genre
select  m.genre,m.title,max(r.rating) as rating
from movies m join rating r
on m.movie_id=r.movie_id
group by m.genre,m.title

-----3.find the overall highest-rated movie
select top 1 m.title,m.genre,max(r.rating) as overall_rating
from movies m
join rating r
on m.movie_id=r.movie_id
group by m.title,m.genre 
order by overall_rating desc 

-----4.find the overall lowest rated movie
select top 1 m.genre,m.title,min(r.rating) as lowest_rated_movie
from movies m
join rating r
on m.movie_id=r.movie_id
group by m.genre,m.title
order by lowest_rated_movie

-----5.find the average rating per genre
select m.genre,m.title,avg(r.rating) as avg_genre
from movies m
join rating r
on m.movie_id=r.movie_id
group by m.genre,m.title
order by avg_genre


