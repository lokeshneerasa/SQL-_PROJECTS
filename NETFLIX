--------------------SQL JOINS------------------------------
---------->1.INNER JOIN
SELECT A.ACCOUNTID,A.ACCOUNTNAME,A.CATEGORYID,C.CATEGORYNAME AS SECTION
FROM ACCOUNT A
JOIN CATEGORIES C ON A.CATEGORYID = C.CATEGORYID
ORDER BY A.ACCOUNTID,A.ACCOUNTNAME
----------->2.LEFT JOIN
SELECT A.ACCOUNTID,A.ACCOUNTNAME,A.CATEGORYID,COALESCE(C.CATEGORYNAME,0) AS SECTION
FROM ACCOUNT A
JOIN CATEGORIES C ON A.CATEGORYID = C.CATEGORYID
ORDER BY A.ACCOUNTID,A.ACCOUNTNAME

