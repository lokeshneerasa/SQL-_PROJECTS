--------------------SQL QUERIES----------------
SELECT S1.ROLLNO,S1.NAMEE,S1.CLASS,S2.SUBJECT,S2.MARKS
FROM
STUDENTS1 S1 INNER JOIN STUDENTS2 S2
ON
S1.ROLLNO=S2.ROLLNO
----------------FAILED STUDENTS -----------------------
SELECT S1.ROLLNO,S1.NAMEE,S1.CLASS,S2.SUBJECT,S2.MARKS
FROM STUDENTS1 S1
INNER JOIN STUDENTS2 S2
ON S1.ROLLNO=S2.ROLLNO
WHERE MARKS<35

------------------AVG MARKS PER SUBJECT---------------
SELECT SUBJECT,AVG(MARKS) AS AVG_MARKS
FROM STUDENTS2 S2
GROUP BY SUBJECT
----------------STUDENTS AVG MARKS --------------------
SELECT S1.ROLLNO,S1.NAMEE,S1.CLASS,AVG(MARKS) AS AVG_MARKS
FROM 
STUDENTS1 S1 INNER JOIN STUDENTS2 S2
ON 
S1.ROLLNO=S2.ROLLNO
GROUP BY S1.ROLLNO,S1.NAMEE,S1.CLASS
ORDER BY AVG_MARKS DESC
--------------------MAXIMUM MARKS---------------------
SELECT S1.ROLLNO,S1.NAMEE,S1.CLASS,AVG(MARKS) AS AVG_MARKS,MAX(MARKS) AS MAX_MARKS
FROM
STUDENTS1 S1 INNER JOIN STUDENTS2 S2
ON 
S1.ROLLNO=S2.ROLLNO
GROUP BY S1.ROLLNO,S1.NAMEE,S1.CLASS
ORDER BY MAX_MARKS DESC
---------------------TOPPER OF THE CLASS--------------------
SELECT TOP 1
S1.ROLLNO,S1.NAMEE,S1.CLASS,AVG(MARKS) AS AVG_MARKS
FROM
STUDENTS1 S1 INNER JOIN STUDENTS2 S2
ON
S1.ROLLNO=S2.ROLLNO
GROUP BY S1.ROLLNO,S1.NAMEE,S1.CLASS
ORDER BY AVG_MARKS DESC
----------------------POOR STUDENT OF THE CLASS----------
SELECT TOP 1
S1.ROLLNO,S1.NAMEE,S1.CLASS,AVG(MARKS) AS AVG_MARKS
FROM
STUDENTS1 S1 INNER JOIN STUDENTS2 S2
ON
S1.ROLLNO=S2.ROLLNO
GROUP BY S1.ROLLNO,S1.NAMEE,S1.CLASS
ORDER BY AVG_MARKS
