----1.show all customers with their orders innerjoin----
select c.customer_id,c.name,c.city,o.rder_id,o.product,o.amount
from customers c
inner join orders o
on c.customer_id = o.customer_id
----2.Show all customers and their orders (including customers with no orders)
select c.customer_id,c.name,c.city,o.rder_id,o.product,o.amount
from customers c 
full join orders o
on c.customer_id=o.customer_id
-----3.Show all orders even if customer does not exist
