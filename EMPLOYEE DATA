------4.Show customer name and product they ordered
select c.customer_id,c.name,c.city,o.rder_id,o.product,o.amount
from customers c
inner join orders o
on c.customer_id=o.customer_id

----5.Find total order amount per customer
select c.customer_id,c.name,sum(o.amount) as total_amount
from customers c
right join orders o
on c.customer_id=o.customer_id
group by c.customer_id,c.name
-----6.Find customers who placed more than 1 order
select c.customer_id,c.name,count(o.rder_id) as total_orders
from customers c
inner join orders o
on c.customer_id=o.customer_id
group by c.customer_id,c.name
having count(o.rder_id)>1
----7.Show customers who have NOT placed any orders
select c.customer_id,c.name,c.city,o.rder_id
from customers c
left join orders o
on c.customer_id=o.customer_id
where o.rder_id is null
----8.Show orders with payment status
select o.rder_id,o.product,o.amount,p.payment_id,p.status
from orders o
right join payments p
on o.rder_id=p.order_id

----9.Find customers whose orders are all “Paid”
select c.customer_id,c.name,c.city,o.rder_id,o.product,o.amount,p.status
from customers c 
inner join orders o on c.customer_id=o.customer_id
inner join payments p on o.rder_id=p.order_id
where status='paid'

----10.Find customers with at least one “Pending” payment
select  c.customer_id,c.name,c.city,o.rder_id,o.product,o.amount,p.status
from customers c
inner join orders o on c.customer_id=o.customer_id
inner join payments p on o.rder_id=p.order_id
where status='pending'

-----11.Show total amount of paid orders per customer
select c.customer_id,c.name,sum(o.amount) as total_amount
from customers c
inner join orders o on c.customer_id=o.customer_id
inner join payments p on o.rder_id=p.order_id
where p.status='paid'
group by c.customer_id,c.name

------12.Find highest order amount per city
select c.city,max(o.amount) as highest_order
from customers c
inner join orders o on c.customer_id=o.customer_id
group by c.city


-----Nested Subqueries
------1.Find employees whose salary is greater than max salary of HR but less than max of IT
select name, department, salary
from employees
where salary > (
    select max(salary)
    from employees
    where department = 'HR'
)
and salary < (
    select max(salary)
    from employees
    where department = 'IT'
)

-----2.Find customers whose order amount is greater than average order of their city
select distinct c.customer_id, c.name, c.city, o.amount
from customers c
inner join orders o on c.customer_id = o.customer_id
where o.amount > (
    select AVG(o2.amount)
    from orders o2
    inner join customers c2 on o2.customer_id = c2.customer_id
    where c.city = c2.city
)
----3.Find products whose price is higher than average price of their category
select product, category, price
from sales s1
where price > (
    select avg(price)
    from sales s2
    where s1.category = s2.category
)
----4.Find employees who work in departments where average salary > overall average
select name, department, salary
from employees
where department in (
    select department
    from employees
    group by department
    having avg(salary) > (
    select AVG(salary) from employees
    )
)
